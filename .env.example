# Bot-Token von @BotFather
TELEGRAM_BOT_TOKEN=

# Erlaubte Telegram-User-IDs, komma-separiert. Das ist die Zugangskontrolle:
# wer hier nicht steht, bekommt "Unauthorized". Eigene ID via @userinfobot.
TELEGRAM_ALLOWED_USERS=

# Arbeitsverzeichnis der Claude-Session (cwd des Subprozesses)
CLAUDE_WORKING_DIR=/path/to/working/directory

# Zusaetzliche Verzeichnisse, die Claude lesen darf (--add-dir), komma-separiert
ALLOWED_PATHS=/path/to/dir1,/path/to/dir2,/tmp

# Optional: Timeout des Subprozesses in ms (Default 300000 = 5 Minuten)
CLAUDE_TIMEOUT_MS=300000

# Optional: Datei mit dem Auftrag dieser Instanz, wird an den System-Prompt
# gehaengt und pro Nachricht neu gelesen. Ohne den Wert gilt der eingebaute
# Wiedervorlage-Kontext.
INSTANCE_PROMPT_FILE=

# Optional: .env, aus der telegram-send-file.sh Token und Chat-ID liest. Bei
# mehreren Instanzen auf die eigene zeigen lassen, sonst geht die Datei ueber
# den Bot der anderen Instanz raus.
TELEGRAM_BOT_ENV_FILE=

# Optional: Ablage der Session-Handoff-Dateien (Default <repo>/data/sessions)
SESSION_DIR=

# Optional: Pfad des Audit-Logs
AUDIT_LOG=/tmp/telegram-claude-code-audit.log
