# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Allowed Telegram user IDs (comma-separated)
# Get your ID from @userinfobot
TELEGRAM_ALLOWED_USERS=

# Working directory for Claude
CLAUDE_WORKING_DIR=/path/to/working/directory

# Allowed paths Claude can access (comma-separated)
ALLOWED_PATHS=/path/to/dir1,/path/to/dir2,/tmp

# Optional: Subprocess timeout in milliseconds (default: 300000 = 5 minutes)
CLAUDE_TIMEOUT_MS=300000

# Optional: Safety mode - "off", "standard" (default), or "paranoid"
# - off: no command restrictions
# - standard: blocks rm -rf, git reset --hard, git push --force, etc.
# - paranoid: standard + blocks interpreter one-liners (python -c, bash -c, etc.)
SAFETY_MODE=standard

# Optional: Audit log path
AUDIT_LOG=/tmp/telegram-claude-code-audit.log
